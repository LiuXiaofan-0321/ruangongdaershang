# Common recent settings file for Wireshark 4.6.8.
#
# This file is regenerated each time Wireshark is quit
# and when changing configuration profile.
# So be careful, if you want to make manual changes here.

######## Recent capture files (latest last), cannot be altered through command line ########

recent.capture_file: C:\University Courses\计算机网络lab\lab1.pcapng
recent.capture_file: C:\University Courses\计算机网络lab\_lab2_工作\captures\Lab2_刘小凡_单播.pcapng
recent.capture_file: C:\University Courses\计算机网络lab\_lab2_工作\captures\Lab2_刘小凡_广播组播.pcapng
recent.capture_file: C:\University Courses\计算机网络lab\_lab3_work\captures\Lab3_HTTP_target.pcapng
recent.capture_file: C:\University Courses\计算机网络lab\_lab4_work\Lab4_ARP.pcapng
recent.capture_file: C:\University Courses\计算机网络lab\Lab4_ARP.pcapng

######## Recent capture filters (latest first), cannot be altered through command line ########


######## Recent display filters (latest last), cannot be altered through command line ########

recent.display_filter: frame.number == 5 || frame.number == 6
recent.display_filter: eth.dst.ig==1&&eth.dst!=ff:ff:ff:ff:ff:ff
recent.display_filter: eth.dst==ff:ff:ff:ff:ff:ff
recent.display_filter: icmp
recent.display_filter: tcp.stream == 95 && tcp.srcport == 80
recent.display_filter: tcp.stream == 95
recent.display_filter: http
recent.display_filter: frame.number == 101068
recent.display_filter: eth.dst == ff:ff:ff:ff:ff:ff
recent.display_filter: ip.version == 4

######## Recent remote hosts (latest first), cannot be altered through command line ########


# Main window geometry.
# Decimal numbers.
gui.geometry_main_x: 17
gui.geometry_main_y: 10
gui.geometry_main_width: 890
gui.geometry_main_height: 745

# Main window maximized.
# true or false (case-insensitive).
gui.geometry_main_maximized: false

# Main window geometry state.
# Hex byte string.
gui.geometry_main: 01d9d0cb00030000000000110000000a0000038a0000030f00000011000000270000038a0000030f000000000000000005a000000011000000270000038a0000030f

# Leftalign Action Buttons.
# true or false (case-insensitive).
gui.geometry_leftalign_actions: false

# Last used Configuration Profile.
gui.last_used_profile: Default

# Number of packets or events to check for automatic profile switching.
# Decimal number. Zero disables switching.
#gui.profile_switch_check_count: 1000

# Warn if running with elevated permissions (e.g. as root).
# true or false (case-insensitive).
privs.warn_if_elevated: true

# Warn if Wireshark is unable to capture.
# true or false (case-insensitive).
sys.warn_if_no_capture: true

# Find packet search in.
# One of: PACKET_LIST, PACKET_DETAILS, PACKET_BYTES
gui.search_in: PACKET_LIST

# Find packet character set.
# One of: NARROW_AND_WIDE, NARROW, WIDE
gui.search_char_set: NARROW_AND_WIDE

# Find packet case sensitive search.
# true or false (case-insensitive).
gui.search_case_sensitive: false

# Find packet search reverse direction.
# true or false (case-insensitive).
gui.search_reverse_dir: false

# Find packet search multiple occurrences.
# true or false (case-insensitive).
gui.search_multiple_occurs: false

# Find packet search type.
# One of: DISPLAY_FILTER, HEX_VALUE, STRING, REGEX
gui.search_type: DISPLAY_FILTER

# Welcome page sidebar Learn section visible.
# true or false (case-insensitive).
gui.welcome_page.sidebar.learn_visible: true

# Welcome page sidebar Tips section visible.
# true or false (case-insensitive).
gui.welcome_page.sidebar.tips_visible: true

# Welcome page sidebar Tips event slides.
# true or false (case-insensitive).
gui.welcome_page.sidebar.tips_events: true

# Welcome page sidebar Tips sponsorship slides.
# true or false (case-insensitive).
gui.welcome_page.sidebar.tips_sponsorship: true

# Welcome page sidebar Tips tip-of-the-day slides.
# true or false (case-insensitive).
gui.welcome_page.sidebar.tips_tips: true

# Welcome page sidebar Tips auto advance slides.
# true or false (case-insensitive).
gui.welcome_page.sidebar.tips_auto_advance: true

# Welcome page sidebar Tips slide auto-advance interval in seconds.
gui.welcome_page.sidebar.tips_interval: 8

# Geometry and maximized state of PacketDialog window.
# Decimal integers.
gui.geom.PacketDialog.x: 462
gui.geom.PacketDialog.y: 252
gui.geom.PacketDialog.width: 759
gui.geom.PacketDialog.height: 559
# true or false (case-insensitive).
gui.geom.PacketDialog.maximized: false
# Qt Geometry State (hex byte string).
gui.geom.PacketDialog.qt_geometry: 01d9d0cb00030000000001ce000000fc000004c400000347000001ce00000119000004c400000347000000000000000005a0000001ce00000119000004c400000347

# Custom colors.
# List of custom colors selected in Qt color picker.
gui.custom_colors: 
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff",
	"ffffffff", "ffffffff"
